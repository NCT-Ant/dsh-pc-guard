  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NCT-Ant/dsh-pc-guard.git"
  },
  "homepage": "https://github.com/NCT-Ant/dsh-pc-guard#readme",
  "bugs": {
    "url": "https://github.com/NCT-Ant/dsh-pc-guard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
